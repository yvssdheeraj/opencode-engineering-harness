{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "developer",
  "instructions": [
    ".opencode/rules/common/communication.md",
    ".opencode/rules/common/context-management.md",
    ".opencode/rules/common/delegation.md",
    ".opencode/rules/common/tool-use.md",
    ".opencode/rules/common/autonomy-and-safety.md",
    ".opencode/rules/common/collaboration.md",
    ".opencode/rules/common/evidence-and-reporting.md"
  ],
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.env.sample", "effect": "allow" },
    { "action": "read", "resource": "*.env.template", "effect": "allow" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },
    { "action": "read", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "read", "resource": ".aws/*", "effect": "deny" },
    { "action": "read", "resource": ".ssh/*", "effect": "deny" },
    { "action": "read", "resource": "secrets/*", "effect": "deny" },
    { "action": "read", "resource": "*credentials*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": ".*", "effect": "ask" },
    { "action": "grep", "resource": ".+", "effect": "ask" },
    { "action": "grep", "resource": "^.*", "effect": "ask" },
    { "action": "grep", "resource": "^.+", "effect": "ask" },
    { "action": "grep", "resource": "*PRIVATE KEY*", "effect": "deny" },
    { "action": "grep", "resource": "*BEGIN * KEY*", "effect": "deny" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "ask" },
    { "action": "webfetch", "resource": "*", "effect": "ask" }
  ]
}