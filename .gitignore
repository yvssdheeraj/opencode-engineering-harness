# macOS / OS metadata
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db

# Editor & IDE directories
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Environment & secrets (never commit; aligned with .ignore and opencode.jsonc)
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
*id_rsa*
*id_ed25519*
.aws/
.ssh/
secrets/
*credentials*

# Node / npx (if running `npx skills` locally)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# OpenCode / local agent runtime artifacts & logs
*.log
.opencode/cache/
.opencode/tmp/

# Python bytecode cache (from scripts/validate_harness.py & tests/)
__pycache__/
*.py[cod]

# Temporary / scratch files
tmp/
temp/
*.tmp
*.bak